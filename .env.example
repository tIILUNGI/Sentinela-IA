# SENTINELA AI - Environment Variables

# App
APP_NAME=SENTINELA AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./sentinela.db

# Storage (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# AI Provider Configuration
# Supported providers: openai, azure_openai, mock (mock is for local dev only when no key is configured; returns explicit unavailable markers, not fake analysis)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60

# OCR
OCR_PROVIDER=tesseract
TESSERACT_CMD=

# Redis/Celery (optional, for async document processing)
REDIS_URL=redis://localhost:6379/0
ASYNC_PROCESSING=false

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

